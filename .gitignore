# Datasets — images are never committed, manifests and content JSON are
data/images/
data/raw/
*.pt
*.pth
*.onnx
# The deployed model (built by ml/export.py) is committed so a host can build
# the API image straight from git: model.onnx, labels.json, meta.json.
!services/api/model/model.onnx
# The paper's EfficientNet-B0 baseline; eval/ benchmarks load it from here
!backend/model.pt

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.venv/
venv/
site-packages/
.env

# LaTeX build artifacts (regenerated by pdflatex)
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz
texput.log
# ...but keep the benchmark run logs, they are provenance for the results
!eval/run.log
!eval/run_plantdoc.log

# Node
node_modules/
dist/
.pnpm-store/

# ML artefacts
ml/runs/
ml/checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test and build caches
.pytest_cache/
*.tsbuildinfo

# Lab->field experiments: weights, caches and per-image outputs stay local
experiments/cache/
experiments/cropscan_runs/
experiments/cropscan_runs.zip
experiments/results/*.npz
!experiments/models/mixed-field.pt
